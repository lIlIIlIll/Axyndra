    "id": "cli-ssh-help",
    "args": ["ssh", "--help"],
    "projection": "command_help_surface",
    "tokens": [
      "add",
      "remove",
      "list",
      "--json",
      "--host",
      "--user",
      "--port",
      "--key",
      "--desc",
      "--compat",
      "--scope"
    ],
    "isolatedHome": true,
    "timeoutSeconds": 5
  },
  {
    "id": "cli-ssh-empty-json",
    "steps": [
      {"args": ["ssh", "list", "--json"]}
    ],
    "projection": "ssh_lifecycle",
    "isolatedHome": true,
    "timeoutSeconds": 5
  },
  {
    "id": "cli-ssh-user-lifecycle",
    "steps": [
      {
        "args": [
          "ssh", "add", "alpha",
          "--host", "example.com",
          "--user", "elliot",
          "--port", "2222",
          "--key", "/tmp/key",
          "--desc", "demo",
          "--compat",
          "--scope", "user"
        ]
      },
      {"args": ["ssh", "list", "--json"]},
      {
        "args": [
          "ssh", "add", "alpha",
          "--host", "duplicate.example",
          "--scope", "user"
        ]
      },
      {"args": ["ssh", "remove", "alpha", "--scope", "user"]},
      {"args": ["ssh", "list", "--json"]}
    ],
    "projection": "ssh_lifecycle",
    "isolatedHome": true,
    "timeoutSeconds": 10
  },
  {
    "id": "cli-ssh-invalid-port",
    "args": ["ssh", "add", "alpha", "--host", "x", "--port", "70000"],
    "projection": "command_usage_error",
