update.source_unconfigured|user.email|user.name|value.invalid_json|visible.txt|web_search.arguments_invalid|web_search.command_argument|web_search.command_invalid|web_search.configuration_invalid|web_search.failed|web_search.frame_invalid|web_search.frame_limit|web_search.host_plan_invalid|web_search.input_limit|web_search.protocol_identity|web_search.response_invalid|web_search.response_limit|web_search.result_limit|web_search.service_identity|web_search.transport_failed|worker.js|workflow.action|workflow.command_invalid|workflow.command_unknown|workflow.continuation_schema|workflow.continuation_selector|workflow.document_fact_ambiguous|workflow.document_fact_invalid|workflow.document_fact_missing|workflow.document_plan_changed|workflow.document_plan_invalid|workflow.goal_observation_invalid|workflow.goal_observation_missing|workflow.guidance_invalid|workflow.input_invalid|workflow.live_policy_missing|workflow.method|workflow.mode|workflow.plan_tool|workflow.plan_tool_missing|workflow.preparation_query_invalid|workflow.role_changed|workflow.role_invalid|workflow.role_unknown|workflow.roles_invalid|workflow.schema|workflow.source_changed|workflow.task_invalid|workflow.todo_file_route_required|workflow.tool_unknown|workflow.tools|workspace.argument|workspace.commit|workspace.contribution_invalid|workspace.edit_limit|workspace.execute|workspace.expected_content_changed|workspace.failed|workspace.file_limit|workspace.input_limit|workspace.invocation_closed|workspace.is_directory|workspace.not_found|workspace.not_regular|workspace.output_invalid|workspace.output_limit|workspace.output_pending|workspace.parent_binding_outside_workspace|workspace.parent_changed|workspace.parent_missing|workspace.parent_not_directory|workspace.path_empty|workspace.path_escape|workspace.path_unsupported|workspace.precondition_conflict|workspace.prepare|workspace.prepare_invalid|workspace.protocol|workspace.protocol_identity|workspace.read|workspace.read_too_large|workspace.resolve|workspace.resolve_read|workspace.resolve_write|workspace.resource_invalid|workspace.resource_unavailable|workspace.selection_changed|workspace.selection_invalid|workspace.selection_unprovided|workspace.sensitive_path_unsupported|workspace.sensitive_write_denied|workspace.service_failed|workspace.service_identity|workspace.timeout|workspace.tool_unknown|workspace.tool_unprovided|workspace.transaction_duplicate_path|workspace.transaction_prepare|workspace.transactions_unavailable|workspace.write|worktree.root_not_directory|worktree.scan_failed|write.content_invalid|write.content_required|write.content_too_large|write.path_required|write.result_not_object|yarn.lock|yield.type_invalid|"
func workspaceDiagnosticCode(value: String): String {
    if(value.size>128){return "invalid-code"}
    for(byte in value.toArray()){if(byte<33 || byte>126){return "invalid-code"};if(byte==124u8){return "unlisted-code"}}
    if(!WORKSPACE_DIAGNOSTIC_LITERAL_CODES.contains("|"+value+"|")){return "unlisted-code"}
    value
}
func workspaceDiagnosticError(site: String,error: AgentError): Unit {
    let kind=match(error.kind){
        case AgentErrorKind.Configuration=>"Configuration"
        case AgentErrorKind.Authentication=>"Authentication"
        case AgentErrorKind.PermissionDenied=>"PermissionDenied"
        case AgentErrorKind.InvalidInput=>"InvalidInput"
        case AgentErrorKind.RateLimited=>"RateLimited"
        case AgentErrorKind.Timeout=>"Timeout"
        case AgentErrorKind.Transport=>"Transport"
        case AgentErrorKind.Provider=>"Provider"
        case AgentErrorKind.Protocol=>"Protocol"
        case AgentErrorKind.Cancelled=>"Cancelled"
        case AgentErrorKind.BudgetExceeded=>"BudgetExceeded"
        case AgentErrorKind.Conflict=>"Conflict"
        case AgentErrorKind.RecoveryRequired=>"RecoveryRequired"
        case AgentErrorKind.Internal=>"Internal"}
    println("ISSUE45_WORKSPACE_RESULT site="+site+" kind="+kind+" code="+workspaceDiagnosticCode(error.code))
}

@Test
class WorkspaceDiagnosticFormatterTests {
    @TestCase
    func pipeSeparatedKnownCodesCannotPassAsOneFixedLiteral(): Unit {
        @Expect(workspaceDiagnosticCode("a.py|a.txt"),"unlisted-code")
        @Expect(workspaceDiagnosticCode("extension.prepare_input_too_large"),"extension.prepare_input_too_large")
        @Expect(workspaceDiagnosticCode("extension.prepare_input_too_large\n"),"invalid-code")
        @Expect(workspaceDiagnosticCode(String.fromUtf8(Array<Byte>(129,repeat:97u8))),"invalid-code")
    }
}
