package agent_app

import agent_domain.*
import agent_cli.*
import agent_product.*
import std.collection.*

func runCompletionsCli(arguments: Array<String>): Int64 {
    if (arguments.size != 1 ||
        (arguments[0] != "bash" &&
        arguments[0] != "zsh" &&
        arguments[0] != "fish")) {
        println("Usage: axyndra completions <bash|zsh|fish>")
        return 1
    }
    match (arguments[0]) {
        case "bash" => print(bashCompletion())
        case "zsh" => print(zshCompletion())
        case "fish" => print(fishCompletion())
        case _ => ()
    }
    0
}

func runDynamicCompletionCli(
    product: ProductRuntime,
    arguments: Array<String>
): Int64 {
    let values = ArrayList<String>()
    for (argument in arguments where argument != "--") {
        values.add(argument)
    }
    if (values.isEmpty()) { return 0 }
    let kind = values[0]
    let prefix = if (values.size > 1) {
        values[values.size - 1]
    } else {
        ""
    }
    if (kind == "models") {
        let candidates = ArrayList<CompletionCandidate>()
        let session = product.applicationSession()
        for (model in session.models()) {
            let provider = session.modelProvider(model)
            candidates.add(CompletionCandidate(model, detail: cleanCompletionDescription(provider)))
            let raw = session.rawModelId(model)
            if (raw != model) {
                candidates.add(CompletionCandidate(raw, detail: cleanCompletionDescription(provider)))
            }
        }
        printCompletionCandidates(
            filterCompletionCandidates(
                candidates.toArray(),
                prefix,
                mode: CompletionMatchMode.Contains
            )
        )
    } else if (kind == "sessions") {
        let candidates = ArrayList<CompletionCandidate>()
        match (product.sessions()) {
            case Result.Ok(sessions) =>
                for (sessionId in sessions) {
                    let title = match (product.sessionName(sessionId)) {
                        case Result.Ok(value) =>
                            cleanCompletionDescription(value)
                        case Result.Err(_) => ""
                    }
                    candidates.add(CompletionCandidate(sessionId.value, detail: title))
                }
            case Result.Err(error) =>
                println(error.code + ": " + error.message)
                return 1
        }
        printCompletionCandidates(filterCompletionCandidates(candidates.toArray(), prefix))
    } else if (kind == "commands") {
        printCompletionCandidates(completionCommandCandidates(prefix))
    }
    0
}

func printCompletionCandidates(candidates: Array<CompletionCandidate>): Unit {
    for (candidate in candidates) {
        println(candidate.value + "\t" + candidate.detail)
    }
}

func cleanCompletionDescription(value: String): String {
    var result = ""
    for (rune in value.runes()) {
        if (rune == r'\t' || rune == r'\r' || rune == r'\n') {
            if (!result.endsWith(" ")) { result += " " }
        } else {
            result += rune.toString()
        }
        if (result.size >= 72) { break }
    }
    result.trimAscii()
}

func completionCommandCandidates(prefix: String): Array<CompletionCandidate> {
    let candidates = ArrayList<CompletionCandidate>()
    for (spec in reservedCliCommandRegistry().visibleCommands()) {
        candidates.add(
            CompletionCandidate(
                spec.name,
                detail: cleanCompletionDescription(spec.description)
            )
        )
    }
    filterCompletionCandidates(candidates.toArray(), prefix)
}

func zshCommandDefinitions(): String {
    var result = ""
    for (candidate in completionCommandCandidates("")) {
        result += "    '" + candidate.value + ":" + candidate.detail + "'\n"
    }
    result
}

func fishCommandDefinitions(): String {
    var result = ""
    for (candidate in completionCommandCandidates("")) {
        result += fishCommand(candidate.value, candidate.detail)
    }
    result
}

func bashCompletion(): String {
    "# bash completion for axyndra — generated by " +
        "`axyndra completions bash`\n" +
        "_axyndra_complete() {\n" +
        "  local cur prev command\n" +
        "  COMPREPLY=()\n" +
        "  cur=\"" + "$" + "{COMP_WORDS[COMP_CWORD]}\"\n" +
        "  prev=\"" + "$" + "{COMP_WORDS[COMP_CWORD-1]}\"\n" +
        "  command=\"" + "$" + "{COMP_WORDS[1]}\"\n" +
        "  if [[ \"$prev\" == \"--model\" ]]; then\n" +
        "    COMPREPLY=( $(axyndra __complete models -- \"$cur\" | cut -f1) )\n" +
        "  elif [[ \"$prev\" == \"--session\" ]]; then\n" +
        "    COMPREPLY=( $(axyndra __complete sessions -- \"$cur\" | cut -f1) )\n" +
        "  elif [[ $COMP_CWORD -eq 1 ]]; then\n" +
        "    COMPREPLY=( $(axyndra __complete commands -- \"$cur\" | cut -f1) )\n" +
        "  elif [[ \"$command\" == \"completions\" ]]; then\n" +
        "    COMPREPLY=( $(compgen -W 'bash zsh fish' -- \"$cur\") )\n" +
        "  else\n" +
        "    COMPREPLY=( $(compgen -W '--help --version --print " +
        "--mode --model --cwd --approval-mode --fixture' " +
        "-- \"$cur\") )\n" +
        "  fi\n" +
        "}\n" +
        "complete -F _axyndra_complete axyndra\n"
}

func zshCompletion(): String {
    "#compdef axyndra\n" +
        "# zsh completion for axyndra — generated by " +
        "`axyndra completions zsh`\n" +
        "_axyndra() {\n" +
        "  local -a commands\n" +
        "  commands=(\n" +
        zshCommandDefinitions() +
        "  )\n" +
        "  _arguments -C \\\n" +
        "    '--help[Show help]' \\\n" +
        "    '--version[Show version]' \\\n" +
        "    '--print[Print one response]' \\\n" +
        "    '--mode[Select mode]:mode:(text json rpc rpc-ui acp)' \\\n" +
        "    '--model[Select model]:model:->models' \\\n" +
        "    '--cwd[Set workspace]:directory:_directories' \\\n" +
        "    '1:command:->commands' '*::argument:->args'\n" +
        "  case $state in\n" +
        "    commands) _describe 'command' commands ;;\n" +
        "    models)\n" +
        "      local -a models\n" +
        "      models=(" + "$" +
        "{(f)\"$(axyndra __complete models -- $words[CURRENT])\"})\n" +
        "      _describe 'model' models ;;\n" +
        "    args)\n" +
        "      [[ $words[2] == completions ]] && " +
        "_values 'shell' bash zsh fish ;;\n" +
        "  esac\n" +
        "}\n" +
        "compdef _axyndra axyndra\n"
}

func fishCompletion(): String {
    "# fish completion for axyndra — generated by " +
        "`axyndra completions fish`\n" +
        "complete -c axyndra -f\n" +
        fishCommandDefinitions() +
        "complete -c axyndra -n '__fish_seen_subcommand_from " +
        "completions' -a 'bash zsh fish'\n" +
        "complete -c axyndra -l help -d 'Show help'\n" +
        "complete -c axyndra -l version -d 'Show version'\n" +
        "complete -c axyndra -l print -d 'Print one response'\n" +
        "complete -c axyndra -l mode -a 'text json rpc rpc-ui acp'\n" +
        "complete -c axyndra -l model -a " +
        "'(axyndra __complete models | string split \\t -f1)'\n" +
        "complete -c axyndra -l cwd -r -a '(__fish_complete_directories)'\n"
}

func fishCommand(name: String, description: String): String {
    "complete -c axyndra -n '__fish_use_subcommand' -a '" +
        name + "' -d '" + description + "'\n"
}
