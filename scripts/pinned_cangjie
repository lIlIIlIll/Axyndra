#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
sdk_root=$(DISABLE_ZOXIDE=1 "$root/scripts/check_sdk.sh")
source "$root/scripts/sdk_paths.sh"
stdx_root=$(resolve_cangjie_stdx_path "$sdk_root")
export CANGJIE_SDK_ROOT="$sdk_root"
export AXYNDRA_SDK_ROOT="$sdk_root"
export AXYNDRA_STDX_ROOT="$stdx_root"
export AXYNDRA_NATIVE_ROOT="$root/libs/process4cj/native"

prepare_network_bridge() (
  umask 077
  source_path="$AXYNDRA_NATIVE_ROOT/sandbox-net-bridge"
  if [[ ! -x "$source_path" ]]; then
    printf 'axyndra: built network bridge is missing: %s\n' "$source_path" >&2
    exit 1
  fi
  if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    runtime_dir="$XDG_RUNTIME_DIR/axyndra"
  elif [[ -n "${HOME:-}" ]]; then
    runtime_dir="$HOME/.cache/axyndra"
  else
    printf 'axyndra: no product-owned runtime directory is available\n' >&2
    exit 1
  fi
  if [[ "$runtime_dir" != /* ]]; then
    printf 'axyndra: runtime directory must be absolute\n' >&2
    exit 1
  fi
  mkdir -p -- "$runtime_dir"
  chmod 0700 -- "$runtime_dir"
  runtime_dir=$(readlink -f -- "$runtime_dir")
  root_real=$(readlink -f -- "$root")
  case "$runtime_dir" in
    "$root_real"|"$root_real"/*)
      printf 'axyndra: network bridge runtime directory is inside the workspace\n' >&2
      exit 1
      ;;
  esac
  owner=$(stat -c '%u' -- "$runtime_dir")
  mode=$(stat -c '%a' -- "$runtime_dir")
  if [[ "$owner" != "$(id -u)" || "$mode" != "700" ]]; then
    printf 'axyndra: network bridge runtime directory is not product-owned\n' >&2
    exit 1
  fi
  destination="$runtime_dir/sandbox-net-bridge"
  temporary="$destination.$$"
  rm -f -- "$temporary"
  install -m 0755 -- "$source_path" "$temporary"
  if ! cmp -s -- "$source_path" "$temporary"; then
    rm -f -- "$temporary"
    printf 'axyndra: copied network bridge failed verification\n' >&2
    exit 1
  fi
  mv -f -- "$temporary" "$destination"
  chmod 0755 -- "$destination"
  if ! cmp -s -- "$source_path" "$destination" ||
      [[ "$(stat -c '%u' -- "$destination")" != "$(id -u)" ]] ||
      [[ "$(stat -c '%a' -- "$destination")" != "755" ]]; then
    rm -f -- "$destination"
    printf 'axyndra: installed network bridge failed verification\n' >&2
    exit 1
  fi
  printf '%s\n' "$destination"
)

export DISABLE_ZOXIDE=1
export CANGJIE_HOME="$sdk_root"
export CANGJIE_ROOT="$sdk_root"
export CANGJIE_PATH="$sdk_root"
export CANGJIE_STDX_PATH="$stdx_root"
export PATH="$sdk_root/bin:$sdk_root/tools/bin:$PATH"
export LD_LIBRARY_PATH="$AXYNDRA_NATIVE_ROOT:$stdx_root:$sdk_root/runtime/lib/linux_x86_64_cjnative:$sdk_root/tools/lib"

"$root/scripts/prepare_native_deps.sh"
export AXYNDRA_NETWORK_BRIDGE="$(prepare_network_bridge)"
native_compiler=${AXYNDRA_NATIVE_CC:-$(command -v clang || true)}
if [[ -n "$native_compiler" ]]; then
  clang_resource_dir=$("$native_compiler" --print-resource-dir 2>/dev/null || true)
  if [[ -d "$clang_resource_dir/lib/linux" ]]; then
    export AXYNDRA_CLANG_RUNTIME_PATH="$clang_resource_dir/lib/linux"
  fi
fi

command=("$@")
if [[ -n "${AXYNDRA_CANONICAL_TARGET_ROOT:-}" && ${command[0]##*/} == cjpm && ${#command[@]} -ge 2 && ${command[1]} =~ ^(bench|build|run|test)$ ]]; then
  cjc_identity=$(stat -Lc '%d:%i:%s:%Y' -- "$sdk_root/bin/cjc")
  cjpm_identity=$(stat -Lc '%d:%i:%s:%Y' -- "$sdk_root/tools/bin/cjpm")
  native_compiler_dir=$(cd -- "$(dirname -- "$native_compiler")" && pwd -P)
  native_compiler_path="$native_compiler_dir/$(basename -- "$native_compiler")"
  native_compiler_identity=$(stat -Lc '%d:%i:%s:%Y' -- "$native_compiler_path")
  native_compiler_version=$("$native_compiler_path" --version 2>&1)
  native_compiler_version=${native_compiler_version%%$'\n'*}
  toolchain_key=$(printf '%s' \
    "$sdk_root|$cjc_identity|$cjpm_identity|$stdx_root|$native_compiler_path|$native_compiler_identity|$native_compiler_version" | \
    sha256sum | cut -c1-16)
  workdir_key=$(printf '%s' "$(pwd -P)" | sha256sum | cut -c1-16)
  target_dir="$AXYNDRA_CANONICAL_TARGET_ROOT/$toolchain_key/$workdir_key"
  mkdir -p -- "$target_dir"
  command+=(--target-dir "$target_dir")
fi

exec "${command[@]}"
